# Lockfiles are generated by npm, and nobody reviews them line by line. Marking
# them keeps a dependency bump from reading as a thousand-line change: GitHub
# collapses them in a pull request and leaves them out of the language stats.
#
# They ARE committed, and have to be: CI runs `npm ci`, which refuses to run
# without a lockfile, and actions/setup-node keys its cache on one. That is the
# point of them — the app ships no runtime dependencies, but eslint and
# electron each pull in dozens of transitive ones, and an install that resolves
# differently on a runner than on a laptop turns someone else's bad publish
# into our mystery CI failure.
package-lock.json linguist-generated=true
app/package-lock.json linguist-generated=true
